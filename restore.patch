+// -------- Notification Functions (Toast Style for Project Sections) --------
+window.loadAndShowSeoProjectToasts = async function() {
+    try {
+        const userStr = localStorage.getItem('currentUser');
+        if (!userStr) return;
+        const user = JSON.parse(userStr);
+        const res = await fetch('/api/seo-notifications/' + user.id);
+        const data = await res.json();
+
+        if (!data.success || !data.data || data.data.length === 0) {
+            document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+            return;
+        }
+
+        // Remove old toasts to avoid duplicates
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+
+        // Render each notification card stacked on upper-right
+        data.data.forEach((n, idx) => {
+            const isUrgent = n.message.includes('due today');
+            const isSoon   = n.message.includes('due in 2 days');
+            
+            const borderCol = isUrgent ? '#d32f2f' : (isSoon ? '#059669' : '#0057b7');
+            const iconBg    = isUrgent ? '#fee2e2' : (isSoon ? '#d1fae5' : '#e0f2fe');
+            const iconColor = isUrgent ? '#b91c1c' : (isSoon ? '#047857' : '#0284c7');
+            const iconClass = n.message.includes('Report') ? 'fa-chart-pie' : 'fa-bell';
+            const topOffset = 20 + (idx * 86);
+
+            const toast = document.createElement('div');
+            toast.className = 'seo-notif-toast';
+            toast.style.cssText = `position:fixed; top:${topOffset}px; right:20px; z-index:99999; background:#ffffff; color:#1e293b; padding:12px 16px; border-radius:10px; border:1px solid #e2e8f0; border-left:5px solid ${borderCol}; box-shadow:0 10px 25px -5px rgba(0,0,0,0.12), 0 8px 10px -6px rgba(0,0,0,0.04); font-size:13px; width:360px; max-width:calc(100vw - 40px); display:flex; align-items:flex-start; gap:12px; animation:slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);`;
+            toast.innerHTML = `
+                <div style="background:${iconBg}; color:${iconColor}; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
+                    <i class="fas ${iconClass}" style="font-size:14px;"></i>
+                </div>
+                <div style="flex:1; min-width:0;">
+                    <div style="font-weight:600; color:#0f172a; line-height:1.4; margin-bottom:3px; word-break:break-word;">${n.message}</div>
+                    <div style="font-size:11px; color:#64748b; font-weight:500;">${new Date(n.created_at).toLocaleString()}</div>
+                </div>
+                <button onclick="dismissSeoNotif(${n.id}, this)" style="background:transparent; border:none; color:#94a3b8; font-size:18px; line-height:1; cursor:pointer; padding:2px 4px; border-radius:4px; margin-left:4px;" title="Dismiss" onmouseover="this.style.color='#1e293b'" onmouseout="this.style.color='#94a3b8'">&times;</button>`;
+            document.body.appendChild(toast);
+        });
+
+    } catch(e) { console.error(e); }
+};
