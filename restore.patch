+// -------- saveSeoDailyWork --------
+window.saveSeoDailyWork = async function() {
+    const assignmentId = document.getElementById('seoAssignmentIdField') ? document.getElementById('seoAssignmentIdField').value : '';
+    const type = document.getElementById('seoTypeField') ? document.getElementById('seoTypeField').value : '';
+    if (!type) { showSeoToast('Please select an SEO type first', 'error'); return; }
+    const date = document.getElementById('seoWorkDate') ? document.getElementById('seoWorkDate').value : '';
+    if (!date) { showSeoToast('Work Date is required', 'error'); return; }
+    const status = document.getElementById('seoWorkStatus') ? document.getElementById('seoWorkStatus').value : 'Completed';
+    const remarks = document.getElementById('seoWorkRemarks') ? document.getElementById('seoWorkRemarks').value : '';
+    const timeSpent = document.getElementById('seoTimeSpent') ? document.getElementById('seoTimeSpent').value : '';
+    if ((status === 'Blocked' || status === 'On Hold') && !remarks.trim()) {
+        showSeoToast('Please provide remarks for Blocked/On Hold status', 'error');
+        return;
+    }
+    const payload = {
+        seo_assignment_id: assignmentId,
+        employee_id: seoUser ? seoUser.id : '',
+        work_date: date,
+        seo_type: type,
+        status: status,
+        remarks: remarks,
+        time_spent: timeSpent,
+        work_category: document.getElementById('dynamic_work_category') ? document.getElementById('dynamic_work_category').value : '',
+        task: document.getElementById('dynamic_task') ? document.getElementById('dynamic_task').value : '',
+        page_url: document.getElementById('dynamic_page_url') ? document.getElementById('dynamic_page_url').value : '',
+        description: document.getElementById('dynamic_description') ? document.getElementById('dynamic_description').value : '',
+        result: document.getElementById('dynamic_result') ? document.getElementById('dynamic_result').value : ''
+    };
+    try {
+        const editId = window.currentEditingSeoWorkId;
+        const url = editId ? `/api/seo-daily-work/${editId}` : '/api/seo-daily-work';
+        const method = editId ? 'PUT' : 'POST';
+
+        const res = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
+        const data = await res.json();
+        if (data.success) {
+            window.currentEditingSeoWorkId = null;
+            showSeoToast('Daily work saved successfully!', 'success');
+            const form = document.getElementById('seoDailyForm');
+            if (form) form.reset();
+            const formContainer = document.getElementById('seoWorkFormContainer');
+            if (formContainer) formContainer.classList.add('hidden');
+            const modal = document.getElementById('seoAddWorkModal');
+            if (modal) modal.classList.add('hidden');
+            loadWorkspaceHistory(assignmentId);
+        } else {
+            showSeoToast(data.message || 'Failed to save daily work', 'error');
+        }
+    } catch(err) { showSeoToast('Error: ' + err.message, 'error'); }
+};
