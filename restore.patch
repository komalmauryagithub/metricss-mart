+window.saveVaultReport = async function(e) {
+    e.preventDefault();
+    const assignmentId = window.currentVaultAssignmentId;
+    if (!assignmentId) return;
+
+    const title = document.getElementById('reportTitle').value;
+    const reportDate = document.getElementById('reportDate').value;
+    let fileUrl = document.getElementById('reportFileUrl').value;
+    const remarks = document.getElementById('reportRemarks').value;
+    const fileInput = document.getElementById('reportFileInput');
+
+    const saveBtn = document.getElementById('saveReportBtn');
+    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Uploading...'; }
+
+    try {
+        // Check if file selected for upload
+        if (fileInput && fileInput.files && fileInput.files[0]) {
+            const formData = new FormData();
+            formData.append('report_file', fileInput.files[0]);
+
+            const uploadRes = await fetch('/api/seo-reports/upload', {
+                method: 'POST',
+                body: formData
+            });
+            const uploadData = await uploadRes.json();
+            if (uploadData.success && uploadData.file_url) {
+                fileUrl = uploadData.file_url;
+            } else {
+                alert(uploadData.message || 'File upload failed');
+                if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save & Upload Report'; }
+                return;
+            }
+        }
+
+        const res = await fetch(`/api/seo-assignments/${assignmentId}/reports`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
