+window.downloadCsvFile = function(filename, csvContent) {
+    const blob = new Blob(["\ufeff" + csvContent], { type: 'text/csv;charset=utf-8;' });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.setAttribute("href", url);
+    link.setAttribute("download", filename);
+    document.body.appendChild(link);
+    link.click();
+    document.body.removeChild(link);
+};
+
+window.escapeCsvCell = function(val) {
+    if (val === null || val === undefined) return '""';
+    const str = String(val).replace(/"/g, '""');
+    return `"${str}"`;
+};
+
+window.exportVaultLoginsToCsv = function() {
+    const list = window.currentVaultLoginsList || [];
+    const projName = window.currentVaultProjectObj ? (window.currentVaultProjectObj.project_name || 'Project') : 'Project';
+    
+    if (list.length === 0) {
+        alert('No login details found to export.');
+        return;
+    }
+
+    let csv = ["Platform / Service,Login URL,Username / Email,Password,Notes"];
+    list.forEach(item => {
+        csv.push([
+            escapeCsvCell(item.platform_name),
+            escapeCsvCell(item.login_url),
+            escapeCsvCell(item.username),
+            escapeCsvCell(item.password),
+            escapeCsvCell(item.notes)
+        ].join(','));
+    });
+
+    const filename = `${projName.replace(/[^a-zA-Z0-9_-]/g, '_')}_Logins.csv`;
+    downloadCsvFile(filename, csv.join('\n'));
+};
