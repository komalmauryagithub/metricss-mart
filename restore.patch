+// -------- showSection implementation for SEO Dashboard --------
+window.showSection = function(sectionId) {
+    if (typeof closePhaseTracker === 'function') closePhaseTracker();
+    if (typeof closeModal === 'function') closeModal();
+
+    // 1. Hide all sections explicitly
+    document.querySelectorAll('.section').forEach(sec => {
+        sec.classList.remove('active');
+        sec.style.display = 'none';
+    });
+
+    // 2. Show target section explicitly
+    const targetSection = document.getElementById(sectionId);
+    if (targetSection) {
+        targetSection.classList.add('active');
+        targetSection.style.display = 'block';
+    } else {
+        console.warn('Section not found:', sectionId);
+    }
+
+    // 3. Update sidebar active item safely
+    document.querySelectorAll('.sidebar li').forEach(li => {
+        li.classList.remove('active');
+        const onclickAttr = li.getAttribute('onclick') || '';
+        if (onclickAttr.includes(`'${sectionId}'`) || onclickAttr.includes(`"${sectionId}"`)) {
+            li.classList.add('active');
+        }
+    });
+
+    // 4. Trigger section-specific loaders
+    if (sectionId === 'dashboard') {
+        if (typeof loadDevDashboard === 'function') loadDevDashboard();
+    } else if (sectionId === 'assigned' || sectionId === 'ongoing' || sectionId === 'completed') {
+        loadAssignedSeoProjects();
+        if (typeof loadAssignedAdsProjects === 'function') loadAssignedAdsProjects();
+        if (sectionId === 'assigned' || sectionId === 'ongoing') {
+            setTimeout(() => loadAndShowSeoProjectToasts(), 300);
+        } else {
+            document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+        }
+    } else if (sectionId === 'pending-gmb-reports') {
+        if (typeof loadPendingGmbReports === 'function') loadPendingGmbReports();
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+    } else if (sectionId === 'attendance') {
+        if (typeof fetchAttendance === 'function') fetchAttendance();
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+    } else if (sectionId === 'salary') {
+        if (window.PayrollUI?.handleSectionShown) window.PayrollUI.handleSectionShown('salary');
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+    } else if (sectionId === 'reports') {
+        if (typeof loadReports === 'function') loadReports();
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+    } else {
+        document.querySelectorAll('.seo-notif-toast').forEach(t => t.remove());
+    }
+};
