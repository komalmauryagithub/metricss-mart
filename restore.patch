+// -------- selectSeoType --------
+window.selectSeoType = function(type) {
+    const typeField = document.getElementById('seoTypeField');
+    const titleEl = document.getElementById('selectedSeoTypeTitle');
+    if (typeField) typeField.value = type;
+    if (titleEl) titleEl.textContent = type + ' Details';
+
+    const buttons = document.querySelectorAll('#seoTypeSelection button');
+    buttons.forEach(btn => {
+        if (btn.textContent.trim() === type) {
+            btn.classList.remove('gray');
+            btn.classList.add('cyan-btn');
+        } else {
+            btn.classList.remove('cyan-btn');
+            btn.classList.add('gray');
+        }
+    });
+
+    const container = document.getElementById('dynamicSeoFields');
+    if (!container) return;
+    container.innerHTML = '';
+    const fields = seoFieldsConfig[type] || [];
+    fields.forEach(f => {
+        let inputHtml = '';
+        if (f.type === 'select') {
+            const opts = f.options.map(o => `<option value="${o}">${o}</option>`).join('');
+            inputHtml = `<select id="dynamic_${f.name}" class="styled-input" style="width:100%;">${opts}</select>`;
+        } else if (f.type === 'textarea') {
+            inputHtml = `<textarea id="dynamic_${f.name}" class="styled-input" rows="2" style="width:100%;"></textarea>`;
+        } else {
+            inputHtml = `<input type="${f.type}" id="dynamic_${f.name}" class="styled-input" style="width:100%;">`;
+        }
+        container.innerHTML += `<div style="margin-bottom:10px;"><label style="font-weight:600; margin-bottom:4px; display:block;">${f.label}</label>${inputHtml}</div>`;
+    });
+    const formContainer = document.getElementById('seoWorkFormContainer');
+    if (formContainer) formContainer.classList.remove('hidden');
+};
