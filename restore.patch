+                        <td>
+                            <span class="vault-badge" style="background:${k.status === 'Active' ? '#dcfce7; color:#15803d;' : '#f1f5f9; color:#64748b;'}">${escapeHtml(k.status || 'Active')}</span>
+                        </td>
+                        <td style="color:#64748b; font-size:12.5px;">${escapeHtml(k.notes || '-')}</td>
