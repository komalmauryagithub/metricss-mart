+window.saveVaultKeyword = async function(e) {
+    e.preventDefault();
+    const id = document.getElementById('keywordDetailId').value;
+    const assignmentId = window.currentVaultAssignmentId;
+    if (!assignmentId) return;
+
+    const payload = {
+        keyword: document.getElementById('kwName').value,
+        target_url: document.getElementById('kwTargetUrl').value,
+        search_volume: document.getElementById('kwVolume').value,
+        target_rank: document.getElementById('kwTargetRank').value,
+        current_rank: document.getElementById('kwCurrentRank').value,
+        status: document.getElementById('kwStatus').value,
+        notes: document.getElementById('kwNotes').value,
+        project_id: window.currentVaultProjectObj ? window.currentVaultProjectObj.project_id : null
+    };
+
+    try {
+        const url = id ? `/api/seo-keywords/${id}` : `/api/seo-assignments/${assignmentId}/keywords`;
+        const method = id ? 'PUT' : 'POST';
+        const res = await fetch(url, {
+            method: method,
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(payload)
+        });
+        const data = await res.json();
+        if (data.success) {
+            document.getElementById('vaultAddKeywordModal').classList.add('hidden');
+            loadVaultKeywords(assignmentId);
+        } else {
+            alert(data.message || 'Failed to save keyword');
+        }
+    } catch(err) {
+        console.error(err);
+        alert('Server error saving keyword');
+    }
+};
