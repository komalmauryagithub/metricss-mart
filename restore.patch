+// --- REPORTS LOGIC ---
+window.loadVaultReports = async function(assignmentId) {
+    const grid = document.getElementById('vaultReportsGrid');
+    const badge = document.getElementById('vaultReportsBadge');
+    if (!grid) return;
+    grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:20px; color:#64748b;"><i class="fas fa-spinner fa-spin"></i> Loading reports...</div>`;
+
+    try {
+        const res = await fetch(`/api/seo-assignments/${assignmentId}/reports`);
+        const data = await res.json();
+        if (data.success && Array.isArray(data.data)) {
+            const reports = data.data;
+            if (badge) badge.textContent = reports.length;
+
+            if (reports.length === 0) {
+                grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:24px; color:#94a3b8; background:white; border:1px solid #e2e8f0; border-radius:12px;"><i class="fas fa-file-pdf" style="font-size:24px; margin-bottom:8px; display:block;"></i>No reports added yet. Click "Upload / Add Report" above.</div>`;
+                return;
+            }
+
+            grid.innerHTML = reports.map(r => {
+                const dateStr = r.report_date ? new Date(r.report_date).toLocaleDateString() : 'N/A';
+                return `
+                    <div class="vault-report-card">
+                        <div>
+                            <div class="vault-report-icon"><i class="fas fa-file-invoice"></i></div>
+                            <h4>${escapeHtml(r.title)}</h4>
+                            <p><i class="far fa-calendar-alt"></i> Date: ${dateStr}</p>
+                            ${r.remarks ? `<p style="font-size:12px; color:#475569;">${escapeHtml(r.remarks)}</p>` : ''}
+                        </div>
+                        <div class="vault-report-actions">
+                            ${r.file_url ? `<a href="${escapeHtml(r.file_url)}" target="_blank" class="btn" style="background:#0f766e; color:white; font-size:12px; padding:6px 12px; font-weight:600;"><i class="fas fa-external-link-alt"></i> View Report</a>` : '<span style="color:#94a3b8; font-size:12px;">No link/file</span>'}
+                            <button class="copy-icon-btn" onclick="deleteVaultReport(${r.id})" style="color:#ef4444;" title="Delete Report"><i class="fas fa-trash"></i></button>
+                        </div>
+                    </div>
+                `;
+            }).join('');
+        }
+    } catch(err) {
+        console.error(err);
+        grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; color:#ef4444;">Failed to load reports.</div>`;
+    }
+};
