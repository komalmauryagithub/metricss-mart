+        const data = await res.json();
+        if (data.success) {
+            document.getElementById('vaultAddReportModal').classList.add('hidden');
+            loadVaultReports(assignmentId);
+        } else {
+            alert(data.message || 'Failed to save report');
+        }
+    } catch(err) {
+        console.error(err);
+        alert('Server error saving report');
+    } finally {
+        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save & Upload Report'; }
+    }
+};
