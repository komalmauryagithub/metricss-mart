+
+let seoUser = null;
+
+// Get the logged-in user from localStorage
+(function initSeoUser() {
+    try {
+        const u = JSON.parse(localStorage.getItem('currentUser') || 'null');
+        if (u) seoUser = u;
+    } catch(e) {}
+})();
+
+// -------- loadAssignedSeoProjects --------
+window.loadAssignedSeoProjects = async function() {
+    const containers = {
+        assigned: document.getElementById('assignedSeoContainer') || document.getElementById('assignedContainer'),
+        ongoing: document.getElementById('ongoingSeoContainer') || document.getElementById('ongoingContainer'),
+        completed: document.getElementById('completedSeoContainer') || document.getElementById('completedContainer')
+    };
+    try {
+        const userStr = localStorage.getItem('currentUser');
+        if (!userStr) return;
+        const user = JSON.parse(userStr);
+        seoUser = user;
+        const res = await fetch('/api/employee-seo-assignments/' + user.id);
+        const data = await res.json();
+        if (!data.success) return;
+
+        const projects = data.data || [
+            ...(data.assigned || []),
+            ...(data.ongoing || []),
+            ...(data.completed || [])
+        ];
+
+        // "Project Assignments" section shows ALL active/assigned projects
+        // "Ongoing" = Active only
+        // "Completed" = Completed/Stopped
+        const assigned = projects.filter(p => {
+            const s = (p.status || '').toLowerCase();
+            return s === 'active' || s === 'assigned';
+        });
+        const ongoing = projects.filter(p => (p.status || '').toLowerCase() === 'active');
+        const completed = projects.filter(p => {
+            const s = (p.status || '').toLowerCase();
+            return s === 'completed' || s === 'stopped';
+        });
+
+        if (document.getElementById('dashboardAssignedCount')) document.getElementById('dashboardAssignedCount').textContent = assigned.length;
+        if (document.getElementById('dashboardOngoingCount')) document.getElementById('dashboardOngoingCount').textContent = ongoing.length;
+        if (document.getElementById('dashboardCompletedCount')) document.getElementById('dashboardCompletedCount').textContent = completed.length;
+
+        // Funnel
+        if (document.getElementById('workFunnelAssigned')) document.getElementById('workFunnelAssigned').textContent = assigned.length;
+        if (document.getElementById('workFunnelOngoing')) document.getElementById('workFunnelOngoing').textContent = ongoing.length;
+        if (document.getElementById('workFunnelCompleted')) document.getElementById('workFunnelCompleted').textContent = completed.length;
+
+        const renderCards = (list, container) => {
+            if (!container) return;
+            if (list.length === 0) {
+                container.innerHTML = '<p style="color:#888;">No SEO projects found.</p>';
+                return;
+            }
+            container.innerHTML = list.map(proj => renderSeoProjectCard(proj)).join('');
+        };
+
+        renderCards(assigned, containers.assigned);
+        renderCards(ongoing, containers.ongoing);
+        renderCards(completed, containers.completed);
+
+    } catch(err) {
+        console.error('loadAssignedSeoProjects error:', err);
+    }
+};
+
+// -------- renderSeoProjectCard --------
+function renderSeoProjectCard(proj) {
+    const serviceType = (proj.seo_service || '').toLowerCase().trim();
+    // GMB detection: value could be 'gmb', 'GMB', 'gmb_seo', 'gmb seo', etc.
+    const isGmb = serviceType === 'gmb' || serviceType.startsWith('gmb');
+    const serviceLabel = isGmb ? 'GMB SEO' : 'Website SEO';
+    const serviceBadgeColor = isGmb ? '#1a7a4a' : '#0057b7';
+
+
+    const priorityColors = {
+        'Urgent': { bg: '#fff0f0', border: '#ff4444' },
+        'High': { bg: '#fffbe6', border: '#ffcc00' },
+        'Medium': { bg: '#f0f7ff', border: '#3399ff' },
+        'Low': { bg: '#f5f5f5', border: '#cccccc' }
+    };
+    const pStyle = priorityColors[proj.priority] || priorityColors['Medium'];
+    const statusLower = (proj.status || '').toLowerCase();
+    const canWork = (statusLower === 'active' || statusLower === 'assigned');
+    const canReactivate = (statusLower === 'completed' || statusLower === 'stopped');
+
+    const coAssigneesStr = (proj.co_assignees || '').trim();
+    const coAssigneesHtml = coAssigneesStr
+        ? `<p style="margin:4px 0; color:#0f172a; font-size:12.5px;"><strong>Also Assigned To:</strong> <span style="color:#0f766e; font-weight:700;">${escapeHtml(coAssigneesStr)}</span></p>`
+        : `<p style="margin:4px 0; color:#64748b; font-size:12px;"><strong>Also Assigned To:</strong> <span style="font-style:italic; color:#94a3b8;">Only You (Solo)</span></p>`;
+
+    const safeCoAssignees = coAssigneesStr.replace(/'/g, "\\'");
+
+    let gmbCardExtraHtml = '';
+    if (isGmb) {
+        let scheduleBadge = '';
+        if (proj.post_schedule_date) {
+            const schedDate = new Date(proj.post_schedule_date);
+            const today = new Date();
+            today.setHours(0,0,0,0);
+            schedDate.setHours(0,0,0,0);
+            const diffDays = Math.ceil((schedDate - today) / (1000 * 60 * 60 * 24));
+            const formattedSchedDate = schedDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
+
+            if (diffDays > 3) {
+                scheduleBadge = `<span style="background:#dcfce7; color:#15803d; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-calendar-check"></i> Scheduled until ${formattedSchedDate}</span>`;
+            } else if (diffDays >= 0) {
+                scheduleBadge = `<span style="background:#fef9c3; color:#a16207; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-clock"></i> Expiring Soon (${formattedSchedDate})</span>`;
+            } else {
+                scheduleBadge = `<span style="background:#fee2e2; color:#b91c1c; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-exclamation-triangle"></i> Expired (${formattedSchedDate})</span>`;
+            }
+        } else {
+            scheduleBadge = `<span style="background:#f1f5f9; color:#64748b; font-size:11px; font-weight:600; padding:2px 8px; border-radius:12px;"><i class="fas fa-calendar"></i> Post Schedule: Not Set</span>`;
+        }
+
+        const listingUrlHtml = proj.listing_url 
+            ? `<p style="margin:4px 0; font-size:12.5px; word-break:break-all;"><strong>Listing URL:</strong> <a href="${escapeHtml(proj.listing_url)}" target="_blank" style="color:#0284c7; text-decoration:underline;">Open Profile Link</a></p>`
+            : '';
+
+        let reportStatusHtml = '';
+        if (proj.next_report_date) {
+            const nextRepDate = new Date(proj.next_report_date);
+            const today = new Date();
+            today.setHours(0,0,0,0);
+            nextRepDate.setHours(0,0,0,0);
+            const isDue = nextRepDate <= today;
+            const repFormatted = nextRepDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
+            if (isDue) {
+                reportStatusHtml = `<span style="background:#fff7ed; color:#c2410c; border:1px solid #ffedd5; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; margin-top:4px; display:inline-block;"><i class="fas fa-file-alt"></i> Monthly Report Due (${repFormatted})</span>`;
+            } else {
+                reportStatusHtml = `<span style="background:#f0f9ff; color:#0369a1; font-size:11px; font-weight:600; padding:2px 8px; border-radius:12px; margin-top:4px; display:inline-block;"><i class="fas fa-check"></i> Report Due: ${repFormatted}</span>`;
+            }
+        }
+
+        gmbCardExtraHtml = `
+            ${listingUrlHtml}
+            <div style="margin:6px 0; display:flex; flex-wrap:wrap; align-items:center; gap:6px;">
+                ${scheduleBadge}
+                <button class="btn" style="background:#16a34a; color:white; font-size:11px; font-weight:600; padding:2px 7px; border-radius:10px;" onclick="extendGmbPostScheduleFromCard('', 15)" title="Extend schedule by 15 days">+15 Days</button>
+            </div>
+            ${reportStatusHtml ? `<div style="margin-bottom:6px;">${reportStatusHtml}</div>` : ''}
+        `;
+    }
+
+    const jsonObjStr = escapeHtml(JSON.stringify(proj));
+
+    return `
+        <div class="project-card" style="background:${pStyle.bg}; border-left: 4px solid ${pStyle.border}; border-radius:10px; padding:18px; position:relative; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
+            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
+                <h3 style="margin:0; font-size:17px; color:#222;">${escapeHtml(proj.project_name || 'Untitled')}</h3>
+                <span style="background:${serviceBadgeColor}; color:white; font-size:11px; font-weight:bold; padding:3px 10px; border-radius:20px;">${serviceLabel}</span>
+            </div>
+            <p style="margin:4px 0; color:#555; font-size:13px;"><strong>Client:</strong> ${escapeHtml(proj.client_name || 'N/A')}</p>
+            ${coAssigneesHtml}
+            ${gmbCardExtraHtml}
+            <p style="margin:4px 0; color:#555; font-size:13px;"><strong>Status:</strong> ${escapeHtml(proj.status || 'N/A')} &nbsp;|&nbsp; <strong>Priority:</strong> ${escapeHtml(proj.priority || 'Medium')}</p>
+            <p style="margin:4px 0; color:#555; font-size:13px;"><strong>Start Date:</strong> ${proj.start_date ? new Date(proj.start_date).toLocaleDateString() : 'N/A'}</p>
+            <div style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
+                ${canWork ? `<button class="btn cyan-btn" onclick="openSeoWork('', '${(proj.project_name||'').replace(/'/g,"\\'")}', '${proj.status}', '${(proj.client_name||'').replace(/'/g,"\\'")}', '${proj.start_date||''}', '${serviceType}', '${safeCoAssignees}', ${jsonObjStr})">Open Workspace</button>` : ''}
+                <button class="btn" style="background:#0f9d58; color:white; font-weight:600; font-size:12.5px;" onclick="openProjectSheetAccess('', '${(proj.sheet_url||'').replace(/'/g,"\\'")}')"><i class="fas fa-file-excel"></i> Sheet Access</button>
+                ${canReactivate ? `<button class="btn gray" onclick="reactivateSeo('')">Reactivate</button>` : ''}
+            </div>
+        </div>
+    `;
+}
+
+// -------- openSeoWork --------
+window.currentActiveSeoProjectObj = null;
+
+window.openSeoWork = async function(assignmentId, projectName, status, clientName, startDate, serviceType, coAssignees) {
+    try {
+        window.currentActiveSeoProject = assignmentId;
+        window.currentActiveSeoProjectObj = { assignmentId, projectName, status, clientName, startDate, serviceType, coAssignees };
+
+        // 1. Immediately switch section to workspace
+        if (typeof showSection === 'function') {
+            showSection('seo-workspace');
+        } else {
+            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
+            const ws = document.getElementById('seo-workspace');
+            if (ws) ws.classList.add('active');
+        }
+
+        // Ensure seo-workspace is visibly active
+        const wsEl = document.getElementById('seo-workspace');
+        if (wsEl) {
+            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
+            wsEl.classList.add('active');
+        }
+
+        // 2. Set project titles & headers
+        const titleEl = document.getElementById('workspaceProjectTitle');
+        const clientEl = document.getElementById('workspaceProjectClient');
+        const coEl = document.getElementById('workspaceProjectCoAssignees');
+        const typeEl = document.getElementById('workspaceProjectType');
+        if (titleEl) titleEl.textContent = projectName || 'SEO Project';
+        if (clientEl) clientEl.textContent = 'Client: ' + (clientName || 'N/A');
+        if (coEl) coEl.innerHTML = coAssignees ? `<strong>Also Assigned To:</strong> ${escapeHtml(coAssignees)}` : `<strong>Also Assigned To:</strong> <span style="font-style:italic; font-weight:normal;">Only You (Solo)</span>`;
+
+        const safeType = (serviceType || '').toLowerCase().trim();
+        const isGmb = safeType === 'gmb' || safeType.startsWith('gmb');
+        if (typeEl) typeEl.textContent = isGmb ? 'GMB SEO' : 'Website SEO';
+
+        const assignIdField = document.getElementById('seoAssignmentIdField');
+        if (assignIdField) assignIdField.value = assignmentId;
+
+        const addBtn = document.getElementById('workspaceAddBtn');
+        const stopBtn = document.getElementById('workspaceStopBtn');
+        const reactBtn = document.getElementById('workspaceReactivateBtn');
+        const stLower = (status || '').toLowerCase();
+        if (stLower === 'active' || stLower === 'assigned') {
+            if (addBtn) addBtn.style.display = 'inline-block';
+            if (stopBtn) stopBtn.style.display = 'inline-block';
+            if (reactBtn) reactBtn.style.display = 'none';
+        } else {
+            if (addBtn) addBtn.style.display = 'none';
+            if (stopBtn) stopBtn.style.display = 'none';
+            if (reactBtn) reactBtn.style.display = 'inline-block';
+        }
+
+        // Set dynamic modal title based on service type
+        const modalTitle = document.getElementById('addDailyWorkModalTitle');
+        const modalLabel = document.getElementById('addDailyWorkModalLabel');
+        if (modalTitle) modalTitle.textContent = isGmb ? 'Add Daily GMB SEO Work' : 'Add Daily Website SEO Work';
+        if (modalLabel) modalLabel.textContent = isGmb ? 'Select GMB SEO Type:' : 'Select Website SEO Type:';
+
+        // Update type buttons in modal
+        const seoTypeSel = document.getElementById('seoTypeSelection');
+        if (seoTypeSel) {
+            const btnDiv = seoTypeSel.querySelector('div');
+            if (btnDiv) {
+                if (isGmb) {
+                    btnDiv.innerHTML = `
+                        <button class="btn gray" onclick="selectSeoType('GMB Setup & Verification')">GMB Setup & Verification</button>
+                        <button class="btn gray" onclick="selectSeoType('Profile Optimization')">Profile Optimization</button>
+                        <button class="btn gray" onclick="selectSeoType('Google Posts & Updates')">Google Posts & Updates</button>
+                        <button class="btn gray" onclick="selectSeoType('Off-Page SEO')">Off-Page SEO</button>
+                        <button class="btn gray" onclick="selectSeoType('Reviews Management')">Reviews Management</button>
+                        <button class="btn gray" onclick="selectSeoType('Local Citations')">Local Citations</button>
+                        <button class="btn gray" onclick="selectSeoType('Insights & Performance')">Insights & Performance</button>
+                    `;
+                } else {
+                    btnDiv.innerHTML = `
+                        <button class="btn gray" onclick="selectSeoType('Keyword Strategy')">Keyword Strategy</button>
+                        <button class="btn gray" onclick="selectSeoType('On-Page Optimization')">On-Page Optimization</button>
+                        <button class="btn gray" onclick="selectSeoType('Off-Page Optimization')">Off-Page Optimization</button>
+                        <button class="btn gray" onclick="selectSeoType('Technical SEO')">Technical SEO</button>
+                        <button class="btn gray" onclick="selectSeoType('Content Creation')">Content Creation</button>
+                        <button class="btn gray" onclick="selectSeoType('Link Building')">Link Building</button>
+                        <button class="btn gray" onclick="selectSeoType('SEO Reporting')">SEO Reporting</button>
+                    `;
+                }
+            }
+        }
+
+        // 3. Load workspace history
+        await loadWorkspaceHistory(assignmentId);
+
+    } catch(err) {
+        console.error('Error opening SEO workspace:', err);
+    }
+};
+
+// -------- openAddDailyWork --------
+window.openAddDailyWork = function() {
+    const modal = document.getElementById('seoAddWorkModal');
+    const formContainer = document.getElementById('seoWorkFormContainer');
+    const form = document.getElementById('seoDailyForm');
+    if (modal) modal.classList.remove('hidden');
+    if (formContainer) formContainer.classList.add('hidden');
+    if (form) form.reset();
+};
+
+// -------- openStopSeoModal --------
+window.openStopSeoModal = function() {
+    const modal = document.getElementById('stopSeoModal');
+    if (modal) modal.classList.remove('hidden');
+};
+
+// -------- confirmStopSeo --------
+window.confirmStopSeo = async function() {
+    const stopDate = document.getElementById('seoStopDate') ? document.getElementById('seoStopDate').value : '';
+    const stopReason = document.getElementById('seoStopReason') ? document.getElementById('seoStopReason').value : '';
+    const assignmentId = window.currentActiveSeoProject;
+    if (!assignmentId) return;
+    try {
+        const res = await fetch('/api/seo-assignments/' + assignmentId + '/stop', {
+            method: 'PUT',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ stop_date: stopDate, stop_reason: stopReason })
+        });
+        const data = await res.json();
+        if (data.success) {
+            document.getElementById('stopSeoModal').classList.add('hidden');
+            showSeoToast('SEO work stopped successfully.', 'success');
+            loadAssignedSeoProjects();
+            if (typeof showSection === 'function') showSection('assigned');
+        } else {
+            showSeoToast(data.message || 'Failed to stop', 'error');
+        }
+    } catch(err) { showSeoToast('Error: ' + err.message, 'error'); }
+};
+
+// -------- loadWorkspaceHistory --------
+window.loadWorkspaceHistory = async function(assignmentId) {
+    try {
+        const res = await fetch('/api/seo-daily-work/' + assignmentId);
+        const data = await res.json();
+        const tbody = document.getElementById('wsHistoryBody');
+        if (!tbody) return;
+        tbody.innerHTML = '';
+
+        if (data.success && data.data) {
+            window.currentSeoDailyWorkList = data.data;
+            renderSeoWorkHistoryTable(data.data);
+        }
+    } catch(err) { console.error('loadWorkspaceHistory error:', err); }
+};
+
+window.renderSeoWorkHistoryTable = function(dataList) {
+    const tbody = document.getElementById('wsHistoryBody');
+    if (!tbody) return;
+    tbody.innerHTML = '';
+
+    let total = dataList.length, completed = 0, inProgress = 0, pending = 0;
+    let types = new Set();
+    let lastActivity = 'N/A';
+
+    if (dataList && dataList.length > 0) {
+        pending = dataList.filter(i => ['on hold','blocked','pending'].includes((i.status||'').toLowerCase())).length;
+        completed = dataList.filter(i => (i.status||'').toLowerCase() === 'completed').length;
+        inProgress = dataList.filter(i => (i.status||'').toLowerCase() === 'in progress').length;
+        dataList.forEach(i => { if (i.seo_type) types.add(i.seo_type); });
+        lastActivity = new Date(dataList[0].work_date).toLocaleDateString();
+
+        tbody.innerHTML = dataList.map(item => {
+            const dateStr = item.work_date ? new Date(item.work_date).toLocaleDateString() : '';
+            const statusBg = item.status === 'Completed' ? '#e6f9ed' : (item.status === 'Blocked' ? '#ffe6e6' : '#fff8e1');
+            const statusColor = item.status === 'Completed' ? '#1a7a4a' : (item.status === 'Blocked' ? '#cc0000' : '#7a6000');
+
+            return `
+                <tr>
+                    <td style="font-weight:600; color:#334155;">${escapeHtml(dateStr)}</td>
+                    <td><strong>${escapeHtml(item.seo_type || '-')}</strong></td>
+                    <td>${escapeHtml(item.work_category || '-')}</td>
+                    <td>${escapeHtml(item.task || item.description || '-')}</td>
+                    <td>${item.page_url ? `<a href="${escapeHtml(item.page_url)}" target="_blank" style="color:#0057b7; font-weight:600;">Link</a>` : '<span style="color:#94a3b8;">-</span>'}</td>
+                    <td><span style="padding:2px 8px; border-radius:12px; font-size:12px; font-weight:600; background:${statusBg}; color:${statusColor};">${escapeHtml(item.status || 'Completed')}</span></td>
+                    <td>${escapeHtml(item.time_spent || '-')}</td>
+                    <td style="text-align:right; white-space:nowrap;">
+                        <button type="button" class="btn" onclick="openEditSeoWorkModal(${item.id})" style="background:#e0f2fe; color:#0369a1; font-size:11.5px; padding:4px 10px; font-weight:600;" title="Edit Entry"><i class="fas fa-edit"></i> Edit</button>
+                        <button type="button" class="copy-icon-btn" onclick="deleteSeoDailyWork(${item.id})" style="color:#ef4444;" title="Delete Entry"><i class="fas fa-trash"></i></button>
+                    </td>
+                </tr>
+            `;
+        }).join('');
+    } else {
+        tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:20px; color:#888;">No daily work records found.</td></tr>';
+    }
+
+    if (document.getElementById('wsTotal')) document.getElementById('wsTotal').textContent = total;
+    if (document.getElementById('wsCompleted')) document.getElementById('wsCompleted').textContent = completed;
+    if (document.getElementById('wsInProgress')) document.getElementById('wsInProgress').textContent = inProgress;
+    if (document.getElementById('wsPending')) document.getElementById('wsPending').textContent = pending;
+    if (document.getElementById('wsTypes')) document.getElementById('wsTypes').textContent = types.size;
+    if (document.getElementById('wsLast')) document.getElementById('wsLast').textContent = lastActivity;
+};
+
+window.filterSeoWorkHistoryByMonth = function() {
+    const filterVal = document.getElementById('seoHistoryMonthFilter')?.value;
+    const all = window.currentSeoDailyWorkList || [];
+    if (!filterVal) {
+        renderSeoWorkHistoryTable(all);
+        return;
+    }
+    const [year, month] = filterVal.split('-');
+    const filtered = all.filter(item => {
+        if (!item.work_date) return false;
+        const d = new Date(item.work_date);
+        return d.getFullYear() === parseInt(year) && (d.getMonth() + 1) === parseInt(month);
+    });
+    renderSeoWorkHistoryTable(filtered);
+};
+
+window.downloadSeoMonthlyWorkReportExcel = function() {
+    const filterVal = document.getElementById('seoHistoryMonthFilter')?.value;
+    const all = window.currentSeoDailyWorkList || [];
+    let listToExport = all;
+
+    if (filterVal) {
+        const [year, month] = filterVal.split('-');
+        listToExport = all.filter(item => {
+            if (!item.work_date) return false;
+            const d = new Date(item.work_date);
+            return d.getFullYear() === parseInt(year) && (d.getMonth() + 1) === parseInt(month);
+        });
+    }
+
+    if (listToExport.length === 0) {
+        alert('No daily work logs found for the selected month to export.');
+        return;
+    }
+
+    const projName = window.currentActiveSeoProjectObj ? (window.currentActiveSeoProjectObj.projectName || window.currentActiveSeoProjectObj.project_name || 'SEO_Project') : 'SEO_Project';
+    
+    let csv = ["Date,SEO Type,Work Category,Task / Description,Target Page URL,Status,Time Spent,Remarks"];
+    listToExport.forEach(item => {
+        const dateStr = item.work_date ? new Date(item.work_date).toLocaleDateString() : '';
+        csv.push([
+            escapeCsvCell(dateStr),
+            escapeCsvCell(item.seo_type),
+            escapeCsvCell(item.work_category),
+            escapeCsvCell(item.task || item.description),
+            escapeCsvCell(item.page_url),
+            escapeCsvCell(item.status),
